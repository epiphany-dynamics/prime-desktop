{
  "name": "prime-desktop",
  "version": "0.6.4",
  "description": "Early public macOS desktop client for Prime Agent \u2014 split chats, live attach, Agents panel. Built by Epiphany Dynamics.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "node scripts/smoke.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --mac",
    "test": "node --test test/*.test.js",
    "ui-smoke": "node scripts/ui-smoke.js && node scripts/window-smoke.js",
    "doctor": "node scripts/doctor.js",
    "postinstall": "node -e \"console.log('\\nPrime Desktop: run npm run doctor   then npm start\\nDocs: docs/INSTALL.md\\n')\"",
    "lint": "node scripts/lint.js",
    "ship-check": "node scripts/ship-check.js"
  },
  "dependencies": {
    "dompurify": "^3.2.4",
    "marked": "^15.0.6"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ai.primeintellect.prime-desktop",
    "productName": "Prime Agent",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "daemon-launch.js",
      "lib/**/*",
      "preload.js",
      "renderer/**/*",
      "node_modules/marked/**/*",
      "node_modules/dompurify/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null
    },
    "artifactName": "${productName}-${version}-${arch}.${ext}"
  },
  "license": "MIT",
  "author": {
    "name": "Epiphany Dynamics",
    "email": "hello@epiphanydynamics.ai",
    "url": "https://epiphanydynamics.ai"
  },
  "homepage": "https://github.com/epiphany-dynamics/prime-desktop",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/epiphany-dynamics/prime-desktop.git"
  },
  "bugs": {
    "url": "https://github.com/epiphany-dynamics/prime-desktop/issues"
  },
  "keywords": [
    "prime-agent",
    "electron",
    "macos",
    "desktop",
    "ai-agent",
    "epiphany-dynamics",
    "prime-intellect"
  ],
  "engines": {
    "node": ">=20"
  }
}
